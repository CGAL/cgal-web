---
layout: null
title : Atom Feed
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">

 <title>{{ site.title | xml_escape }}</title>
 <subtitle>{{ site.description | xml_escape }}</subtitle>
 <link href="{{ site.production_url }}{{ site.JB.atom_path }}" rel="self"/>
 <link href="{{ site.production_url }}"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ site.production_url }}</id>
 <icon>{{ site.production_url }}/images/cgal_logo/g-196x196-y.png</icon>
 <author>
   <name>{{ site.author.name }}</name>
   <email>{{ site.author.email }}</email>
 </author>

 {% for post in site.posts limit: 20 %}
 {%- assign feed_image = post.social_image | default: post.image -%}
 {%- assign feed_image_ext = feed_image | split: "." | last | downcase -%}
 {%- if feed_image_ext == "svg" -%}{%- assign feed_image = nil -%}{%- endif -%}
 {%- assign feed_summary = post.long_description | default: post.description | strip_html | normalize_whitespace | strip %}
 <entry>
   <title>{{ post.title | xml_escape }}</title>
   <link href="{{ site.production_url }}{{ post.url }}"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>{{ site.production_url }}{{ post.id }}</id>
   {%- if feed_summary.size >= 50 %}
   <summary>{{ feed_summary | xml_escape }}</summary>
   {%- endif %}
   {%- if feed_image %}
   <media:thumbnail url="{% unless feed_image contains '://' %}{{ site.production_url }}{% endunless %}{{ feed_image }}"/>
   {%- endif %}
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}

</feed>
